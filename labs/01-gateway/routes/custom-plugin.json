{
  "name": "lab-custom-plugin",
  "uri": "/custom/*",
  "methods": ["GET"],
  "plugins": {
    "lance-request-id": {
      "header": "X-Lance-Request-Id",
      "upstream_header": "X-Lance-Plugin"
    },
    "proxy-rewrite": {
      "regex_uri": ["^/custom/(.*)$", "/$1"]
    }
  },
  "upstream": {
    "type": "roundrobin",
    "nodes": {"orders-a:8080": 1}
  }
}
